  {
    "id": "wkc_split",
    "type": "function",
    "z": "wkc_tab",
    "name": "pecah data",
    "func": "const d = msg.payload || {};\nconst num = v => (typeof v === 'number' && isFinite(v)) ? v : null;\nconst t = num(d.d_temp);\nconst h = num(d.d_hum);\nreturn [\n  t === null ? null : { payload: t },\n  h === null ? null : { payload: h }\n];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 140,
