    "type": "function",
    "z": "wkc_tab",
    "name": "data palsu",
    "func": "const r = (a, b) => Math.round((a + Math.random() * (b - a)) * 10) / 10;\nmsg.payload = {\n  ts: new Date().toLocaleString('sv-SE'),\n  d_temp: r(27, 34),\n  d_hum: r(55, 80)\n};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
